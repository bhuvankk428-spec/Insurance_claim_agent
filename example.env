# Chat backend (RAG)
DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/postgres
OPENAI_API_KEY=your_openai_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=350
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_MIN_CONFIDENCE=0.6
CHAT_PORT=5175
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
REQUIRE_DB_READY=true
STARTUP_DB_TIMEOUT_MS=5000
MAX_PDF_MB=10
MAX_PHOTO_MB=5

# Claimcheck backend
ALLOW_FAKE_GEO=true
STRICT_GEO=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ADMIN_TOKEN=qk-admin-2026
CLAIM_PORT=5174
REQUIRE_SUPABASE_READY=true

# Admin login (frontend)
VITE_ADMIN_EMAIL=admin@qk.ai
# Optional alternative to VITE_ADMIN_EMAIL:
# VITE_ADMIN_EMAILS=admin@qk.ai,ops@qk.ai
VITE_ADMIN_TOKEN=qk-admin-2026

# Finance news (backend)
NEWS_API_KEY=your_marketaux_api_token
NEWS_API_URL=https://api.marketaux.com/v1/news/all
NEWS_QUERY=finance OR markets OR stocks OR economy
NEWS_LANGUAGE=en
NEWS_PAGE_SIZE=12
NEWS_FALLBACK_SYMBOLS=SPY,QQQ,AAPL,MSFT,GOOGL,AMZN,TSLA
